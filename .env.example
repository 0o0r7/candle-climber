# Candle Climber — environment template
# Copy to .env.local and fill values when the corresponding phase ships.
# Never commit real secrets.

# p1 — canonical site URL for OG/twitter metadata (set on Vercel after deploy)
# NEXT_PUBLIC_SITE_URL=https://candle-climber.vercel.app

# Phase p1 — global leaderboard persistence
# Option A (recommended): MongoDB Atlas M0 free tier ($50 credit via GitHub Student Pack)
# Option B: Supabase free tier (Postgres + realtime)
# Behavior: if DATABASE_URL is a mongodb:// or mongodb+srv:// URI, the leaderboard
# automatically uses MongoDB (db: candleclimber, coll: scores). Otherwise it runs
# in-memory (resets on restart). No code changes needed either way.
# DATABASE_URL=

# W1 integrity — HMAC secret signing /api/candles run tokens (anti-forge).
# REQUIRED IN PRODUCTION (fail-closed since 2026-10-13): on a Vercel production
# deploy without it, /api/candles serves terrain WITHOUT a run token (unscored)
# and every token verify rejects — the game plays, submissions stay closed.
# Falls back to DATABASE_URL, then a local-dev default (dev/preview only).
# Never commit a real value.
# RUN_TOKEN_SECRET=

# Phase p2 — wallet connect (Reown / WalletConnect Cloud free tier)
# RESERVED — the in-page injected-provider lane ships (NEXT_PUBLIC_WALLET_ENABLED
# below); the WalletConnect/Reown embedded flow is NOT built yet. Leave unset.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Phase p2 — stock market data proxy (Yahoo Finance public endpoint, no key)
# No config required.

# Phase p3+ — Robinhood Chain testnet (public RPC + faucet, no key)
# Superseded by NEXT_PUBLIC_ROBINHOOD_RPC_URL / ROBINHOOD_RPC_URL (below) — kept
# line removed 2026-10-13 (was never read by code).

# Sentry production monitoring (org james-thomas-st / project candle-climber)
# DSN is public by design; SENTRY_AUTH_TOKEN is secret — used by next build for release + source-map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# G5 prelaunch (2026-10-14): moderation gate for /ops + GET /api/score-report.
# Unset → those surfaces show aggregate counts only. Set to a long random
# value → pass it via ?key= (browser) or the x-ops-token header (API) to see
# the full moderation detail (report queue rows, persisted anomaly flags).
OPS_TOKEN=

# P4 — $WICK token (LIVE 2026-10-05 · launch #5963 · curve 0x9e00b42b…640c)
# Token address is PUBLIC on-chain data — safe as a committed reference value.
WICK_TOKEN_ADDRESS=0xE2cE0Be4e3D420C1e4b5C46493b3d5e03595216c
# ROBINHOOD_RPC_URL=               # server-side read RPC for /api/wallet (P4.2); default https://rpc.testnet.chain.robinhood.com (public, no key, verified 2026-10-06)
# NEXT_PUBLIC_WALLET_ENABLED=      # absent = wallet layer fully inert (set on Vercel after E2 merges)
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=   # public testnet RPC, no key

# W6 — official Robinhood Chain stock price read (server-side: /api/candles + /api/onchain/quote)
# Public, keyless RPCs by default — no config needed. Override only to survive provider
# rate limits; a keyed provider URL IS a secret, so keep it out of git (dashboard/Vercel env).
# ROBINHOOD_MAINNET_RPC=           # default https://rpc.mainnet.chain.robinhood.com (where the real Chainlink stock feeds live; verified 2026-10-07)
# ROBINHOOD_TESTNET_RPC=           # default https://rpc.testnet.chain.robinhood.com (testnet token IDENTITY only — its feeds are mock)

# MongoDB alias: MONGODB_URI is honored as a DATABASE_URL fallback by the
# run-token signer only (src/lib/run-token.ts). Set DATABASE_URL, not both.

# Coming-soon gate (Task T) — REMOVED 2026-10-13: the tester-gate code never
# shipped; ACCESS_* vars were dead config. (.env.example honest-config rule.)

# CCDC minting (server minter) — the EOA key that submits mint txs and pays testnet gas.
# Local: gitignored 0600 file ~/.cc-minter-key (auto-detected). Production: Vercel env var.
# Missing/empty in BOTH places ⇒ /api/deathcard/claim honestly 503s ("minter not configured").
# MINTER_KEY=

# E6.2 graduation gate (src/lib/graduation.ts) — pre-grad defaults are correct; the
# operator touches these ONLY per docs/council/2026-10-10-GRADUATION-RUNBOOK.md.
# GRADUATED=                       # "1" = operator override AFTER the graduation tx is explorer-confirmed (fail-closed otherwise: pad API decides, outage ⇒ pre-grad)
# WEIGHTS_FROZEN=                  # "1" = graduation-snapshot window — weight events pause with honest 503s; scores keep flowing; unfreeze after the Merkle root is published
# PAD_API_URL=                     # default https://testnet.vibevibe.fun/api/v1/chains/46630/v6/launches/<WICK_TOKEN_ADDRESS> (public, keyless)

# PARTNER lane (council 2026-10-12) — curated allowlist v0.
# A strict JSON array; every entry is validated, invalid ones are skipped loudly.
# Fields per entry: id (slug), projectName, symbol, tokenAddress (0x…), curveAddress
# (0x…, the token's VibeVibe bonding curve — the trade-event source, P3-1), walletAddress
# (0x…, the $WICK-holding wallet), addedAt (YYYY-MM-DD), note (optional).
# Empty/unset = the pool is empty (the honest v0 default until partner #1 is approved).
# PARTNER_REGISTRY_JSON=[]

# PARTNER lane price input — OPTIONAL owner override of the $WICK price in ETH.
# $WICK is LIVE (2026-10-05, launchId 5963): the price is now derived
# automatically from the platform's own public feed + its own curve formula,
# invariant-checked against the on-chain reserve on every read (wick-price.ts,
# docs/PARTNER-LANE-DESIGN.md). Set this ONLY to force a hand-verified figure
# (it wins over the live reader and is used as-is). Unset = auto (recommended).
# WICK_ETH_PRICE=
