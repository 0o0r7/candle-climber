# Candle Climber — environment template
# Copy to .env.local and fill values when the corresponding phase ships.
# Never commit real secrets.

# p1 — canonical site URL for OG/twitter metadata (set on Vercel after deploy)
# NEXT_PUBLIC_SITE_URL=https://candle-climber.vercel.app

# Phase p1 — global leaderboard persistence
# Option A (recommended): MongoDB Atlas M0 free tier ($50 credit via GitHub Student Pack)
# Option B: Supabase free tier (Postgres + realtime)
# Behavior: if DATABASE_URL is a mongodb:// or mongodb+srv:// URI, the leaderboard
# automatically uses MongoDB (db: candleclimber, coll: scores). Otherwise it runs
# in-memory (resets on restart). No code changes needed either way.
# DATABASE_URL=

# W1 integrity — HMAC secret signing /api/candles run tokens (anti-forge).
# Set a long random value in production. Falls back to DATABASE_URL, then a
# local-dev default. Never commit a real value.
# RUN_TOKEN_SECRET=

# Phase p2 — wallet connect (Reown / WalletConnect Cloud free tier)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Phase p2 — stock market data proxy (Yahoo Finance public endpoint, no key)
# No config required.

# Phase p3+ — Robinhood Chain testnet (public RPC + faucet, no key)
# NEXT_PUBLIC_CHAIN_RPC_URL=

# Sentry production monitoring (org james-thomas-st / project candle-climber)
# DSN is public by design; SENTRY_AUTH_TOKEN is secret — used by next build for release + source-map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# P4 — $WICK token (LIVE 2026-10-05 · launch #5963 · curve 0x9e00b42b…640c)
# Token address is PUBLIC on-chain data — safe as a committed reference value.
WICK_TOKEN_ADDRESS=0xE2cE0Be4e3D420C1e4b5C46493b3d5e03595216c
# ROBINHOOD_RPC_URL=               # server-side read RPC for /api/wallet (P4.2); default https://rpc.testnet.chain.robinhood.com (public, no key, verified 2026-10-06)
# NEXT_PUBLIC_WALLET_ENABLED=      # absent = wallet layer fully inert (set on Vercel after E2 merges)
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=   # public testnet RPC, no key

# W6 — official Robinhood Chain stock price read (server-side: /api/candles + /api/onchain/quote)
# Public, keyless RPCs by default — no config needed. Override only to survive provider
# rate limits; a keyed provider URL IS a secret, so keep it out of git (dashboard/Vercel env).
# ROBINHOOD_MAINNET_RPC=           # default https://rpc.mainnet.chain.robinhood.com (where the real Chainlink stock feeds live; verified 2026-10-07)
# ROBINHOOD_TESTNET_RPC=           # default https://rpc.testnet.chain.robinhood.com (testnet token IDENTITY only — its feeds are mock)

# Coming-soon gate (Task T) — tester access shell
# NEXT_PUBLIC_ACCESS_GATE=on       # absent = site fully open (launch-day default)
# ACCESS_KEYS=                     # comma-separated tester keys; empty = gate fails OPEN
# ACCESS_KEY_SECRET=               # HMAC secret for the signed tester cookie
# Values live ONLY in .env.local (git-ignored) + Vercel dashboard. Never in chat, never committed.
